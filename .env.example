# Copy to .env and adjust. All paths may be absolute or relative to MS_WORKSPACE.

# Folder holding your Odoo trees, modules, outputs, logs and reports (default: ./workspace)
# MS_WORKSPACE=/path/to/my-odoo-migrations

# Default folder scanned for custom modules (default: <workspace>/custom-modules)
# MS_CUSTOM_DIR=custom-modules

# Your own migration rules; replaces rules/MIGRATION_RULES.md (default: <workspace>/MIGRATION_RULES.md if present)
# MS_RULES_FILE=MIGRATION_RULES.md

# Optional already-migrated module whose conventions Claude should copy (default: <workspace>/reference_module)
# MS_REFERENCE_MODULE=reference_module

# Use an Anthropic API key (billed per token) instead of the logged-in Claude account.
# Off by default: without this, ANTHROPIC_API_KEY is removed before Claude Code runs.
# MS_ALLOW_API_KEY=1
# ANTHROPIC_API_KEY=sk-ant-...

# Ports (both bind to 127.0.0.1 only)
# MS_BACKEND_PORT=8765
# MS_FRONTEND_PORT=5173
